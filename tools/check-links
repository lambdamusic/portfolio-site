#!/usr/bin/env python3
"""
Check that every internal link in the static export resolves to a file.

Scans every HTML file under docs/ (or the folder given as the first argument)
for href/src/srcset attributes, <option value> paths (the typewriter edition
menu navigates with these) and meta-refresh targets; every CSS file for
url(...) references; and sitemap.xml for its <loc> entries. Each link is
resolved the way GitHub Pages serves files:

    /foo        -> foo, foo.html, or foo/index.html
    /foo/       -> foo/index.html

Absolute links to the site's own domain (from docs/CNAME, or the SITE_URL
environment variable for a site on its github.io address) are checked as
internal. Links to 127.0.0.1 or localhost are always broken: they are wget
leftovers for files it could not fetch. Other external links, and pure
#fragments, are skipped. Exits 1 if any link is broken, so it can gate the build.

With --canonical it also fails on any HTML page without a <link rel="canonical">
pointing at the site's own domain. Pages that are not HTML documents (a feed or
an export wget saved as .html), meta-refresh redirect pages, 404.html and
anything under media/ (static files, e.g. hand-built pages) are exempt. Use it once the base template emits canonicals.

Usage:
    tools/check-links [--canonical] [docs]
"""

import os
import re
import sys
from html.parser import HTMLParser
from urllib.parse import unquote, urlsplit

HERE = os.path.dirname(os.path.abspath(__file__))
CNAME_FILE = os.path.join(HERE, "..", "docs", "CNAME")

SKIP_SCHEMES = ("mailto:", "data:", "javascript:", "tel:")
LOCAL_HOSTS = ("127.0.0.1", "localhost")
CSS_URL = re.compile(r"""url\(\s*['"]?([^'")]+)['"]?\s*\)""")
CSS_COMMENT = re.compile(r"/\*.*?\*/", re.S)
# a data: URI is self-contained; an inline SVG inside one can hold url(#id)
# references of its own, which aren't links
CSS_DATA_URI = re.compile(r"""url\(\s*(?:"data:[^"]*"|'data:[^']*'|data:[^)]*)\s*\)""", re.I)
SITEMAP_LOC = re.compile(r"<loc>([^<]+)</loc>")
REFRESH_URL = re.compile(r"url\s*=\s*['\"]?([^'\"]+)", re.I)
CANONICAL = re.compile(r'<link rel="canonical" href="([^"]*)"')
NO_CANONICAL = ("404.html",)  # served at every missing URL, so it has none
NO_CANONICAL_DIRS = ("media/",)  # static files: hand-built pages, not Django's


class LinkParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        for name in ("href", "src"):
            if attrs.get(name):
                self.links.append(attrs[name])
        if attrs.get("srcset"):
            self.links += [c.strip().split(" ")[0] for c in attrs["srcset"].split(",") if c.strip()]
        if tag == "option" and (attrs.get("value") or "").startswith("/"):
            self.links.append(attrs["value"])
        if tag == "meta" and (attrs.get("http-equiv") or "").lower() == "refresh":
            match = REFRESH_URL.search(attrs.get("content") or "")
            if match:
                self.links.append(match.group(1))


def own_host():
    try:
        with open(CNAME_FILE) as f:
            return f.read().strip()
    except OSError:
        return urlsplit(os.environ.get("SITE_URL", "")).hostname


def resolves(root, path):
    """True if a site-root-relative path is served by GitHub Pages."""
    full = os.path.join(root, path.lstrip("/"))
    if path.endswith("/"):
        return os.path.isfile(os.path.join(full, "index.html"))
    return (os.path.isfile(full)
            or os.path.isfile(full + ".html")
            or os.path.isfile(os.path.join(full, "index.html")))


def is_broken(root, dirpath, link, host):
    """None if the link is fine or external, else a reason string."""
    link = link.strip()
    if not link or link.startswith("#") or link.lower().startswith(SKIP_SCHEMES):
        return None
    parts = urlsplit(link)
    if parts.netloc:
        hostname = parts.hostname or ""
        if hostname in LOCAL_HOSTS:
            return "points at a local dev server"
        if hostname != host:
            return None
    path = unquote(parts.path)
    if not path:
        return None
    if not path.startswith("/"):
        rel_dir = os.path.relpath(dirpath, root)
        trailing = "/" if path.endswith("/") else ""
        path = "/" + os.path.normpath(os.path.join(rel_dir, path)).lstrip("./") + trailing
        if path == "//":
            path = "/"
    return None if resolves(root, path) else "missing"


def links_in(path, text):
    if path.endswith(".html"):
        parser = LinkParser()
        parser.feed(text)
        return parser.links
    if path.endswith(".css"):
        return CSS_URL.findall(CSS_DATA_URI.sub("", CSS_COMMENT.sub("", text)))
    if path.endswith("sitemap.xml"):
        return SITEMAP_LOC.findall(text)
    return []


def canonical_problem(text, host):
    """None if the page has a canonical on the site's own domain (or needs none)."""
    if "<html" not in text[:2000].lower() or 'http-equiv="refresh"' in text:
        return None
    match = CANONICAL.search(text)
    if not match:
        return "no canonical"
    if host and urlsplit(match.group(1)).hostname != host:
        return f"canonical on another host: {match.group(1)}"
    return None


def check(root, canonical=False):
    host = own_host()
    broken = []
    for dirpath, _, filenames in os.walk(root):
        for filename in filenames:
            if not filename.endswith((".html", ".css", "sitemap.xml")):
                continue
            source = os.path.join(dirpath, filename)
            with open(source, encoding="utf-8", errors="replace") as f:
                text = f.read()
            rel = os.path.relpath(source, root)
            if (canonical and filename.endswith(".html") and rel not in NO_CANONICAL
                    and not rel.startswith(NO_CANONICAL_DIRS)):
                problem = canonical_problem(text, host)
                if problem:
                    broken.append((rel, "-", problem))
            for link in links_in(source, text):
                reason = is_broken(root, dirpath, link, host)
                if reason:
                    broken.append((os.path.relpath(source, root), link, reason))
    return broken


if __name__ == "__main__":
    args = sys.argv[1:]
    canonical = "--canonical" in args
    args = [a for a in args if a != "--canonical"]
    root = args[0] if args else "docs"
    broken = check(root, canonical)
    for source, link, reason in broken:
        print(f"BROKEN  {source}  ->  {link}  ({reason})")
    if broken:
        print(f"\n{len(broken)} problem(s) in {root}/")
        sys.exit(1)
    print(f"OK: all internal links in {root}/ resolve")
