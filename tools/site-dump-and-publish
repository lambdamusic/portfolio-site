#!/usr/bin/env bash

SECONDS=0

# port of the local Django server; override with e.g. PORT=8011 tools/site-dump-and-publish
export PORT="${PORT:-8000}"

echo "================="
echo "PREREQUISITE"
echo "Ensure site is running on 127.0.0.1:$PORT..."
echo "================="


if lsof -Pi :$PORT -sTCP:LISTEN -t >/dev/null ; then
    echo ">>>>>>> DJANGO is RUNNING! "
    echo "================="
else
    echo "********* Django not running on 127.0.0.1:$PORT **********"
    echo ".. Exiting process. Please run the django server first."
    exit 1
fi


echo "================="
echo "Dumping site.."
echo "================="

# stop before committing if the dump or its build checks failed
./tools/site-dump || exit 1


echo "================="
echo -e "\nCommit and push"
echo "================="

# docs/ only: git add -A would also commit whatever else is lying around
git add docs
git commit -m "live site auto update"
git push


echo -e "\rDone"
echo "================="


# https://stackoverflow.com/questions/8903239/how-to-calculate-time-elapsed-in-bash-script
echo "+++++++++++++++++ DUMP AND PUSH COMPLETED"
duration=$SECONDS
echo "$(($duration / 60)) minutes and $(($duration % 60)) seconds elapsed."